#!/bin/zsh
#
# timer — 30-minute countdown, then a count-up of the overtime
#
#   timer         30 minutes (default)
#   timer 45      45 minutes, for a longer mock
#
# The four phases scale to whatever total you give, keeping the same
# proportions as the 30-minute plan: 0-8 / 8-12 / 12-25 / 25-30.
# Nothing beeps at zero: the terminal is the only output. Ctrl+C stops.
#
# Space or p holds the clock mid-run and the same key starts it again;
# q leaves. A hold costs the clock nothing — the time you were away is
# added back — so stepping out for water does not fake an overtime.
#
# At zero it rolls straight into a count-up on the same line, with no
# break: the clock restarts at 00:00 and climbs, the bar refilling once
# per full interval (30 -> 30+1, 30+2, ...). The bar snapping from full
# back to empty is the only sign you crossed. That climbing number is
# how far off pace you were; it belongs in the post-mortem.

emulate -L zsh
setopt no_notify no_monitor

arg=${1:-30}
case $arg in
  <->m|<->) total=$(( ${arg%m} * 60 )) ;;
  *)        print -u2 "usage: timer [minutes]"; exit 1 ;;
esac
(( total > 0 )) || { print -u2 "timer: duration must be positive"; exit 1 }

width=24
start=$(date +%s)
end=$(( start + total ))

cleanup() { tput cnorm; print ""; exit ${1:-130} }
trap cleanup INT TERM

clock() { printf '%02d:%02d' $(( $1 / 60 )) $(( $1 % 60 )) }

bar() {
  local cells=$1
  printf '\r  [%s%s]  %s  ' \
    "${(l:$cells::#:):-}" "${(l:$(( width - cells ))::.:):-}" "$(clock $2)"
}

draw() {
  local left=$1
  bar $(( (total - left) * width / total )) $left
}

draw_up() {
  local over=$1
  bar $(( (over % total) * width / total )) $over
}

# Sit on the frozen bar until the key comes again, then push end forward
# by however long that took, so the hold leaves the remaining time whole.
hold() {
  local at=$(date +%s) key
  printf 'paused '
  while :; do
    read -s -k 1 key
    case $key in
      ' '|p|P) break ;;
      q|Q)     cleanup 0 ;;
    esac
  done
  end=$(( end + $(date +%s) - at ))
  printf '\r%*s' $(( width + 22 )) ''
}

# A second of waiting that stays awake to the keyboard. Falls back to a
# plain sleep when stdin is not a terminal, so a piped run still counts.
wait_tick() {
  local key
  [[ -t 0 ]] || { sleep 1; return }
  read -s -t 1 -k 1 key || return
  case $key in
    ' '|p|P) hold ;;
    q|Q)     cleanup 0 ;;
  esac
}

tput civis
while :; do
  left=$(( end - $(date +%s) ))
  (( left <= 0 )) && break
  draw $left
  wait_tick
done

# Past the mark, on the same line: the clock climbs instead of falling.
while :; do
  draw_up $(( $(date +%s) - end ))
  wait_tick
done